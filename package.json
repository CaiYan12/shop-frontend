{
  "name": "shop-frontend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "check:docs": "node scripts/check-docs.mjs",
    "check:cart": "vitest run tests/unit/cart-runtime.test.ts",
    "check:ui": "node scripts/acceptance/check-ui.mjs",
    "check:es": "node scripts/acceptance/check-es-degraded.mjs",
    "check:ui:unit": "vitest run tests/unit/native-scrollbar.test.mjs",
    "test:unit": "vitest run",
    "verify": "run-s check:docs test:unit build",
    "stack": "node scripts/stack-status.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@mdi/font": "7.4.47",
    "gsap": "3.15.1",
    "openapi-fetch": "0.17.0",
    "overlayscrollbars": "2.17.1",
    "overlayscrollbars-vue": "0.5.10",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1",
    "vuetify": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tsconfig/node26": "26.0.2",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "31.0.1",
    "npm-run-all2": "9.0.4",
    "sass-embedded": "1.108.2",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unplugin-fonts": "2.1.0",
    "vite": "8.3.8",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
